# ============================================
# Clausent — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local no repositório.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host/clausent_dev?sslmode=require

# --- Better Auth ---
BETTER_AUTH_SECRET=gere-uma-string-aleatoria-com-64-chars
BETTER_AUTH_URL=http://localhost:3000

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...

# --- AWS ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=clausent-uploads
AWS_SQS_ANALYSIS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/...

# --- Resend (Email) ---
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@clausent.com

# --- DeepSeek (AI) ---
DEEPSEEK_API_KEY=sk-...

# --- Perplexity (Pesquisa Contextual — Opcional) ---
PERPLEXITY_API_KEY=pplx-...

# --- Cloudflare Turnstile (CAPTCHA) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...
